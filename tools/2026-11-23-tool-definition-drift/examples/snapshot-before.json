{
  "tools": [
    {
      "name": "create_invoice",
      "description": "Create an invoice for a customer.",
      "annotations": {
        "readOnlyHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "tier": {
            "type": "string",
            "enum": [
              "standard",
              "priority"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "amount"
        ]
      }
    },
    {
      "name": "search_orders",
      "description": "Search orders by filter.",
      "annotations": {
        "readOnlyHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "internal_only": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  ]
}